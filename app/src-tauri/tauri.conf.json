{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨契",
  "version": "../package.json",
  "identifier": "com.moqi.projectb",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "墨契",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false
  }
}
